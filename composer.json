{
    "name": "phpbbmodders/elonw",
    "type": "phpbb-extension",
    "description": "Opens external links in a new window.",
    "homepage": "https://www.phpbbmodders.com/",
    "version": "1.1.0-dev",
    "time": "2026-11-07",
    "keywords": [
        "phpbb",
        "extension",
        "external links",
        "new window"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "phpBB Modders",
            "email": "board@phpbbmodders.com",
            "homepage": "https://www.phpbbmodders.com/",
            "role": "Extension Developer"
        },
        {
            "name": "Rich McGirr",
            "role": "Past Developer"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "composer/installers": "^1.0 || ^2.0"
    },
    "extra": {
        "display-name": "External Links Open in New Window",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.19"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/elonw",
            "filename": "version_check",
            "ssl": true
        }
    }
}
